# Anthropic API key used by the extraction and mapping model calls in src/lib/extraction.ts and
# src/lib/mapping.ts. Every check spends it, which is why the limits below exist.
ANTHROPIC_API_KEY=

# Postgres with the pgvector extension, holding pasted campaigns, their agent files, the daily
# usage counts and the precedent corpus. Unset is a supported state: a check is refused with that
# reason rather than crashing, and the suite runs against PGlite instead.
DATABASE_URL=

# Seed-only. OpenAI API key used by the precedent embedder in src/lib/embedding.ts when
# `npm run seed:precedents` runs. The app does not read it while checking a campaign, and the
# tests inject a deterministic embedder.
OPENAI_API_KEY=

# Key for the HMAC that turns a visitor's IP address into the only form of it ever stored.
# Generate one with `openssl rand -hex 32` and keep it out of the repository. Unset refuses
# every check, because the limits cannot be kept without it (ADR-0011).
IP_HASH_SECRET=

# Checks one visitor may run per UTC day.
ANALYSES_PER_IP_PER_DAY=5

# Checks the whole site may run per UTC day, whoever asks. The backstop on model spend.
ANALYSES_PER_DAY=100

# Days a pasted campaign and its agent file are kept so the shared link keeps working.
RETENTION_DAYS=30
