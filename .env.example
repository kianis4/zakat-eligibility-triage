# Anthropic API key used by the fact-extraction model call in src/lib/extraction.ts.
ANTHROPIC_API_KEY=

# Postgres with the pgvector extension, holding submitted campaigns and the adjudicated
# precedent corpus. Unset is a supported state: the reviewer page says so and the suite
# runs against PGlite instead.
DATABASE_URL=

# OpenAI API key used by the default precedent embedder in src/lib/precedent.ts. Only the
# seed script and a live retrieval need it; the tests inject a deterministic embedder.
OPENAI_API_KEY=

# Slack incoming webhook that escalated campaigns are posted to in src/lib/slack.ts. Unset
# is not a supported state for escalation: the post throws rather than skipping quietly.
SLACK_WEBHOOK_URL=

# Base URL the reviewer UI is served from, used to link an escalation to /campaigns/[id].
# Unset drops the link from the Slack message rather than posting a broken one.
APP_BASE_URL=
